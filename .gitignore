# RepoOS derived index cache
.repoos/
node_modules/

# macOS
.DS_Store

# Local secrets (auth provider keys, session secret) — never commit these
.env

# Build output. Not needed for distribution — npm builds it fresh at publish
# time via `files: ["dist"]` + `prepublishOnly`. Tracking it in git only ever
# manufactured merge conflicts: `dist/.build-info.json` used to carry a
# timestamp that dirtied the tree on every rebuild (fixed by making it
# deterministic — see docs/dogfooding-vs-general.md — but the tracked-file
# problem was the tracking itself, not just that one field).
#
# New task worktrees never had this directory checked out from git in the
# first place: `checkOrchestrationBuild` (bootstrap.ts) reads the MAIN
# checkout's dist/, not the worktree's; `repoos check` always builds fresh
# regardless; and the preview path (preview.ts's `ensureFreshBuild`) already
# builds on demand when a worktree has none. Nothing in the live pipeline
# assumed dist/ pre-existed in a fresh worktree.
dist/

# Regenerated on demand via `repoos screenshots` / `bun run screenshots`.
# Previously tracked on main, but the binary PNGs churned on every rebuild
# and made up ~80% of repo history size — stripped from history 2026-08-20.
screenshots/
