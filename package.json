{
  "name": "repoos",
  "version": "0.5.0",
  "description": "The repo is the operating system. Repo-native, AI-agent-friendly task tracking that lives as markdown files in your monorepo.",
  "type": "module",
  "bin": {
    "repoos": "dist/cli/index.js"
  },
  "main": "dist/core/repoos.js",
  "types": "dist/core/repoos.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/repoos.d.ts",
      "import": "./dist/core/repoos.js"
    },
    "./cli": "./dist/cli/index.js",
    "./server": {
      "types": "./dist/server/server.d.ts",
      "import": "./dist/server/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs && bun run build:ui",
    "build:ui": "vue-tsc --noEmit -p src/ui-app/tsconfig.json && vite build --config src/ui-app/vite.config.ts",
    "dev": "bun src/cli/index.ts",
    "repoos": "bun src/cli/index.ts",
    "lint": "oxlint",
    "fmt": "oxfmt src/ui-app/src src/ui-app/vite.config.ts src/ui-app/tests",
    "test": "vitest run --config src/ui-app/vite.config.ts",
    "screenshots": "bun run build && node scripts/capture-screenshots.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "monorepo",
    "ai-agents",
    "task-management",
    "repo-native",
    "markdown",
    "orchestration",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "devDependencies": {
    "@playwright/test": "1.40.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^30.0.1",
    "lucide-vue-next": "^1.0.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "pinia": "^4.0.2",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.9"
  }
}
