#!/bin/sh
# Pre-commit guards:
# - On main: format/lint for staged source (#0423).
# - On every branch: block build output, oversized staged files, and secret
#   patterns (#1096). Bypass: REPOOS_SKIP_STAGED_ARTIFACT_GUARD=1
# - RepoOS bookkeeping-only stages (work/** reports, *.md only) skip the
#   artifact guard so server commits are not blocked.
#
# Merge commits are never blocked. Format/lint still applies only on main.

branch=$(git symbolic-ref --short -q HEAD 2>/dev/null || true)
git_dir=$(git rev-parse --git-dir)
[ -f "$git_dir/MERGE_HEAD" ] && exit 0

top=$(git rev-parse --show-toplevel)

staged_all=$(git diff --cached --name-only)
staged_artifact=$(echo "$staged_all" | grep -v '^$' || true)
if [ -n "$staged_artifact" ]; then
  if ! echo "$staged_artifact" | grep -qvE '^(work/reports/|work/[^/]+\.md$|inputs/|docs/|user-docs/)'; then
    : # bookkeeping-only — skip artifact guard
  elif [ "${REPOOS_SKIP_STAGED_ARTIFACT_GUARD:-}" != "1" ]; then
    if command -v bun >/dev/null 2>&1; then
      if ! bun "$top/scripts/staged-artifact-pre-commit.mjs" 2>&1; then
        exit 1
      fi
    else
      echo "pre-commit: bun not found — cannot run staged artifact guard (#1096)." >&2
      exit 1
    fi
  fi
fi

[ "$branch" = "main" ] || exit 0

files=$(git diff --cached --name-only --diff-filter=ACMR |
  grep -E '\.(ts|tsx|mts|cts|js|jsx|mjs|cjs|vue|css)$')
[ -n "$files" ] || exit 0

common=$(cd "$(git rev-parse --git-common-dir)" && pwd)
find_bin() {
  for dir in "$top/node_modules/.bin" "$(dirname "$common")/node_modules/.bin"; do
    [ -x "$dir/$1" ] && { echo "$dir/$1"; return; }
  done
  command -v "$1"
}
oxfmt=$(find_bin oxfmt)
oxlint=$(find_bin oxlint)
if [ -z "$oxfmt" ] || [ -z "$oxlint" ]; then
  echo "pre-commit: oxfmt/oxlint not found (run \`bun install\`); skipping the main-branch format/lint guard." >&2
  exit 0
fi

# shellcheck disable=SC2086 # file list is newline-separated repo paths
if ! echo "$files" | xargs "$oxfmt" --check --no-error-on-unmatched-pattern >/dev/null 2>&1; then
  echo "pre-commit: formatting issues in staged files on main:" >&2
  echo "$files" | xargs "$oxfmt" --check --no-error-on-unmatched-pattern >&2
  echo "Run \`bun run fmt\`, re-stage, and commit again." >&2
  exit 1
fi
lint_files=$(echo "$files" | grep -E '\.(ts|tsx|mts|cts|js|jsx|mjs|cjs|vue)$')
# Guard the empty case: `oxlint` with no paths would lint the whole repo.
if [ -n "$lint_files" ] && ! echo "$lint_files" | xargs "$oxlint" >/dev/null 2>&1; then
  echo "pre-commit: lint errors in staged files on main:" >&2
  echo "$lint_files" | xargs "$oxlint" >&2
  exit 1
fi
exit 0
