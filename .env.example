# Local secrets for `repoos serve` when developing RepoOS itself. Copy to
# .env and fill in what you need — .env is gitignored, this file is tracked
# so the repo documents which secrets a full local setup expects. See
# src/core/config.ts's [auth] parsing for how these are read (env wins over
# the corresponding repoos.toml fields when both are set).
#
# NOT auto-loaded: this codebase has no dotenv dependency, so these are only
# picked up if your shell/process manager actually exports them. Either:
#   set -a; source .env; set +a; repoos serve
# or use a tool like direnv, or set them in whatever supervises the process
# (systemd unit, launchd plist, pm2, etc).

# Resend API key, used when [auth.emailProvider].type = "resend" in repoos.toml
REPOOS_RESEND_API_KEY=re_...

# Google OAuth client secret, used when [auth.google] is configured
REPOOS_GOOGLE_CLIENT_SECRET=

# Session signing secret. Optional — auto-generated at startup if unset.
REPOOS_AUTH_SESSION_SECRET=

# Dev-only OTP override so you don't need a real inbox to log into a local
# preview: `verifyOtp` accepts this code for any already-allowlisted user
# instead of the emailed OTP. Never honored when NODE_ENV=production. This is
# a RepoOS-development convenience, not something `repoos init` scaffolds for
# downstream users — see AGENTS.md's preview section for the agent-facing
# writeup.
REPOOS_AUTH_DEV_BACKDOOR_CODE=
