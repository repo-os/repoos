# Copy to .env and fill in for local development. Never commit real values —
# in production every one of these lives in Neon Functions' own secret
# handling (`neon functions deploy --env KEY=VALUE`, or `env:` in neon.ts read
# from process.env at deploy time), never in this repo.

# Pooled Postgres connection string. Locally: your own Neon dev branch or a
# local Postgres. In production: Neon injects this automatically once
# Postgres is enabled on the deployed branch — you do not set it yourself.
DATABASE_URL=postgres://user:password@localhost:5432/telegram_manager

# The official manager bot's token (BotFather, Bot Management Mode enabled).
TELEGRAM_MANAGER_BOT_TOKEN=

# The manager bot's own @username (not secret), used to build deep links.
TELEGRAM_MANAGER_BOT_USERNAME=

# Generate with: openssl rand -hex 32
TELEGRAM_MANAGER_WEBHOOK_SECRET=

# The shared secret every RepoOS instance presents when calling this service.
# Generate with: openssl rand -hex 32
TELEGRAM_MANAGER_INSTANCE_AUTH_KEY=

# AES-256-GCM key for the redemption grace-window envelope. 32 bytes, hex or
# base64. Generate with: openssl rand -hex 32
TELEGRAM_MANAGER_ENCRYPTION_KEY=

# Override only in tests / against a Bot API-compatible test server.
TELEGRAM_API_BASE=https://api.telegram.org
