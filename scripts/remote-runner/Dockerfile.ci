# The container the Remote Validation Runner executes the gate inside.
# Built once and baked into the Hetzner snapshot (see build-snapshot.md); the
# runner never rebuilds it at job time.
#
# Scope (MVP): `bun install` + `bun run build` + `bun run test` only. The
# Playwright/webkit UI smoke test stays on the LOCAL gate — add
# `RUN bunx playwright install --with-deps webkit` here when it moves remote.
FROM oven/bun:1-debian

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl \
 && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# The repo is bind-mounted at /repo and the bun cache at /root/.bun/install/cache
# by validate.sh; the container runs as root (--user 0:0) so it can write both.
WORKDIR /repo
ENV HOME=/root
ENTRYPOINT ["/bin/bash", "-lc"]
