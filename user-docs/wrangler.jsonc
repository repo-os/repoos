{
  // The Worker negotiates Markdown for HTML routes, then serves the same
  // generated static assets through the ASSETS binding.
  //
  // VitePress builds cleanUrls (foo.html for /foo) — default html_handling
  // ("auto-trailing-slash") already serves foo.html at /foo, matching that.
  "name": "repoos-docs",
  "main": "./worker.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./.vitepress/dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
